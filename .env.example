# Server Port
PORT=4000

# Admin Dashboard Access Key (leave empty for open local dev, or set a secure password)
ADMIN_SECRET_KEY=admin12345

# Active SMS Gateway: "simulator" | "twilio" | "custom_http"
SMS_GATEWAY_PROVIDER=simulator

# Twilio Credentials (if using Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Custom HTTP Gateway (if using local telco/custom gateway)
CUSTOM_GATEWAY_URL=
CUSTOM_GATEWAY_METHOD=POST
CUSTOM_GATEWAY_HEADERS={"Content-Type": "application/json"}
CUSTOM_GATEWAY_BODY_TEMPLATE={"to": "{{to}}", "message": "{{message}}"}

# Anti-Abuse Shield Defaults
COOLDOWN_SECONDS=60
DAILY_LIMIT_PER_NUMBER=5
IP_WINDOW_MINUTES=10
IP_MAX_REQUESTS=10
ALLOWED_COUNTRY_CODES=+880,+1,+44
FAKE_SUCCESS_ON_ABUSE=false

# Cloudflare Turnstile (for public OTP form, optional)
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
